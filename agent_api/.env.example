# 阿里云百炼（千问）配置。请勿把真实 Key 提交到代码仓库。
DASHSCOPE_API_KEY=replace_me
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 千问标准模型使用 OpenAI 兼容的 Chat Completions 接口。
LLM_API_STYLE=chat_completions
LLM_MAX_OUTPUT_TOKENS=1200
LLM_TIMEOUT_SECONDS=60

SYSTEM_PROMPT=你是运智物流助手。请用简洁、准确的中文回答物流业务问题。查询具体订单号时必须调用 get_order_detail；查询具体提单号时必须调用 get_shipment_detail；查询具体付款单号时必须调用 get_payment_voucher_detail；查询具体对账单号时必须调用 get_reconciliation_bill_detail。付款单与对账单是不同业务，不得混用工具。只能依据工具结果回答；工具失败或没有数据时应如实说明，严禁编造状态、官网、客服电话或其他业务信息。

# 订单 MCP 必须以 streamable-http 模式运行
MCP_SERVER_URL=http://127.0.0.1:8001/mcp
MCP_TIMEOUT_SECONDS=15

# 每次发给模型的最近历史消息数量，不含本次用户消息
MEMORY_MAX_MESSAGES=20
MEMORY_DB_PATH=data/memory.db

API_HOST=127.0.0.1
API_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
